{
  "name": "vibe-cs",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",

  // Default machine size for Codespaces created from this repo.
  // 4-core / 8 GB / 32 GB disk is enough to load Qwen/Qwen3-0.6B on CPU.
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },

  // Install Torch (CPU build, ~200 MB) + transformers, then pre-download the
  // Qwen/Qwen3-0.6B weights (~1.2 GB) into the HuggingFace cache so the
  // candidate's first call to generate() is instant. Adds ~1–2 min to the
  // initial Codespace build.
  "postCreateCommand": "pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir transformers && python -c \"from transformers import AutoModelForCausalLM, AutoTokenizer; AutoTokenizer.from_pretrained('Qwen/Qwen3-0.6B'); AutoModelForCausalLM.from_pretrained('Qwen/Qwen3-0.6B')\"",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
